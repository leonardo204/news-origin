# ====================
# App 설정
# ====================
# 환경: development, production, test
APP_ENV=development

# 디버그 모드 (development에서만 true 권장)
APP_DEBUG=true

# 보안 키 (production에서는 반드시 변경!)
APP_SECRET_KEY=change-me-in-production

# ====================
# CORS 설정
# ====================
# 허용할 프론트엔드 오리진 (쉼표로 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ====================
# Database (PostgreSQL)
# ====================
# Docker Compose용 PostgreSQL 설정
POSTGRES_USER=newsorigin
POSTGRES_PASSWORD=newsorigin_dev_password
POSTGRES_DB=newsorigin

# PostgreSQL 연결 URL
# 형식: postgresql+asyncpg://사용자:비밀번호@호스트:포트/데이터베이스명
# Docker Compose 사용 시: postgres (서비스명)
# 로컬 개발 시: localhost
DATABASE_URL=postgresql+asyncpg://newsorigin:newsorigin_dev_password@postgres:5432/newsorigin

# ====================
# Qdrant 벡터 DB
# ====================
# Qdrant 서버 호스트 (Docker: qdrant, 로컬: localhost)
QDRANT_HOST=qdrant

# Qdrant HTTP API 포트
QDRANT_PORT=6333

# Qdrant gRPC 포트
QDRANT_GRPC_PORT=6334

# 사용할 컬렉션명
QDRANT_COLLECTION=article_embeddings

# ====================
# Redis
# ====================
# Redis 캐시 URL (DB 0)
# Docker: redis, 로컬: localhost
REDIS_URL=redis://redis:6379/0

# Celery 브로커 URL (DB 1)
CELERY_BROKER_URL=redis://redis:6379/1

# ====================
# Embedding 모델
# ====================
# 사용할 임베딩 모델명
# 추천: paraphrase-multilingual-mpnet-base-v2 (한국어 지원)
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# 임베딩 벡터 차원
EMBEDDING_DIMENSION=768

# ====================
# 뉴스 API (선택사항)
# ====================
# GNews API 키 (https://gnews.io/)
GNEWS_API_KEY=

# ====================
# 크롤링 설정
# ====================
# 크롤링 간 대기 시간 (초)
CRAWL_DELAY_SECONDS=2.0

# 동시 크롤링 최대 수
CRAWL_MAX_CONCURRENT=5

# 크롤러 User-Agent
CRAWL_USER_AGENT=NewsOrigin/0.1 (Research Bot)

# ====================
# 유사도 임계값
# ====================
# 같은 뉴스로 판단하는 임계값 (0.0 ~ 1.0)
SIMILARITY_SAME_THRESHOLD=0.90

# 파생 뉴스로 판단하는 임계값 (0.0 ~ 1.0)
SIMILARITY_DERIVATIVE_THRESHOLD=0.75

# 연관 뉴스로 판단하는 임계값 (0.0 ~ 1.0)
SIMILARITY_RELATED_THRESHOLD=0.60

# ====================
# 로깅
# ====================
# 로그 레벨: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 로그 파일 경로 (선택사항, 미설정 시 콘솔만 출력)
# LOG_FILE=logs/app.log
